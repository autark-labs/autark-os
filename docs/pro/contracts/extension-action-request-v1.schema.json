{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://contracts.autark-os.org/extensions/v1/action-request.schema.json",
  "description": "Authenticated same-origin private UI action. Limit: 16384 encoded bytes. The installed extension owns action and payload semantics.",
  "required": [
    "schemaVersion",
    "surface",
    "actionId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "surface": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,127}$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,127}$"
    },
    "payload": {
      "type": "object"
    }
  }
}
