{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.autark-os.org/pro/v1/change-safety-request.schema.json",
  "title": "Guardian change-safety request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "operation",
    "targetResourceRef",
    "currentVersion",
    "targetVersion",
    "changes",
    "safetyCheckpointRequired",
    "snapshot"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common-v1.schema.json#/$defs/schemaVersion" },
    "planId": { "$ref": "common-v1.schema.json#/$defs/digest" },
    "operation": { "const": "update" },
    "targetResourceRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._-]{1,128}$"
    },
    "currentVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "targetVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "safetyCheckpointRequired": { "const": true },
    "snapshot": { "$ref": "https://contracts.autark-os.org/pro/v1/normalized-host-snapshot.schema.json" }
  }
}
