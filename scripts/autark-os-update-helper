#!/usr/bin/env python3
"""Bounded root operations for browser-authorized Autark-OS core updates.

The backend may invoke this helper through one narrow sudoers rule. It does not
accept a command, URL, filesystem path, or release identity supplied by the
browser. A browser upload is addressed only by a generated bundle id inside the
configured runtime inbox. The helper safely stages the archive, verifies every
checksum and the trusted release signature, records a short-lived one-time
approval, and launches the fixed installed updater in a transient systemd
service so it survives the backend service stopping itself during an update.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import uuid


CONFIG_FILE = Path("/etc/autark-os/autark-os.env")
DEFAULT_RUNTIME = Path("/var/lib/autark-os")
DEFAULT_INSTALL = Path("/opt/autark-os")
ID_RE = re.compile(r"^[a-f0-9]{32}$")
APPROVAL_RE = re.compile(r"^[a-f0-9-]{36}$")
VERSION_RE = re.compile(r"^[0-9][0-9A-Za-z._+-]{0,127}$")
MAX_ARCHIVE_BYTES = 512 * 1024 * 1024
MAX_EXTRACTED_BYTES = 1024 * 1024 * 1024
MAX_ARCHIVE_MEMBERS = 512
APPROVAL_TTL = dt.timedelta(minutes=10)


class HelperError(Exception):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code
        self.message = message


def emit(payload: dict[str, object]) -> None:
    print(json.dumps(payload, separators=(",", ":"), sort_keys=True))


def fail(code: str, message: str) -> None:
    raise HelperError(code, message)


def now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def timestamp(value: dt.datetime | None = None) -> str:
    return (value or now()).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def test_config_path() -> Path:
    # sudo is invoked without --preserve-env in production. This hook lets the
    # repository test protocol behavior without touching /etc.
    value = os.environ.get("AUTARK_OS_UPDATE_HELPER_TEST_CONFIG", "")
    return Path(value) if value else CONFIG_FILE


def parse_config() -> dict[str, str]:
    config_path = test_config_path()
    values: dict[str, str] = {}
    if config_path.is_file():
        for line in config_path.read_text(encoding="utf-8").splitlines():
            key, separator, value = line.partition("=")
            if separator:
                values[key.strip()] = value.strip()
    return values


def configured_paths() -> tuple[Path, Path, Path, Path]:
    values = parse_config()
    runtime = Path(values.get("AUTARK_OS_RUNTIME_ROOT", str(DEFAULT_RUNTIME))).resolve(strict=False)
    install = Path(values.get("AUTARK_OS_INSTALL_DIR", str(DEFAULT_INSTALL))).resolve(strict=False)
    key = Path(values.get("AUTARK_OS_CORE_UPDATE_SIGNING_KEY", "/etc/autark-os/core-update-release.pub"))
    verifier = Path(values.get("AUTARK_OS_CORE_UPDATE_VERIFIER", str(install / "bin/cosign")))
    if not runtime.is_absolute() or not install.is_absolute() or not key.is_absolute() or not verifier.is_absolute():
        fail("invalid_configuration", "The installed core-update configuration is invalid.")
    return runtime, install, key, verifier


def require_root() -> None:
    if os.geteuid() != 0:
        fail("root_required", "The core-update helper must run as root.")


def require_regular_root_owned(path: Path, code: str) -> None:
    try:
        metadata = path.lstat()
    except OSError:
        fail(code, "A required installed update component is missing.")
    if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
        fail(code, "A required installed update component is not a regular file.")
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        fail(code, "A required installed update component has unsafe ownership or permissions.")


def require_private_state_directory(path: Path) -> None:
    try:
        metadata = path.lstat()
    except OSError:
        fail("unsafe_state_path", "The protected core-update state path is unsafe.")
    # main() requires root before reaching this code. Using the current euid
    # keeps the pure protocol tests runnable without granting non-root callers
    # any production capability.
    if (not stat.S_ISDIR(metadata.st_mode)
            or stat.S_ISLNK(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_mode & 0o077):
        fail("unsafe_state_path", "The protected core-update state path is unsafe.")


def state_paths(runtime: Path) -> tuple[Path, Path, Path, Path]:
    root = runtime / "core-update"
    if root.exists() or root.is_symlink():
        require_private_state_directory(root)
    else:
        root.mkdir(mode=0o700, parents=False)
    os.chmod(root, 0o700)
    staged = root / "staged"
    approvals = root / "approvals"
    for path in (staged, approvals):
        if path.exists() or path.is_symlink():
            require_private_state_directory(path)
        else:
            path.mkdir(mode=0o700)
        os.chmod(path, 0o700)
    return root, staged, approvals, root / "state.json"


def load_state(state_file: Path) -> dict[str, object]:
    if not state_file.is_file():
        return {"schemaVersion": 1, "status": "ready", "message": "No core update is in progress.", "updatedAt": timestamp()}
    try:
        value = json.loads(state_file.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        fail("state_unreadable", "The protected core-update state cannot be read safely.")
    if not isinstance(value, dict) or value.get("schemaVersion") != 1:
        fail("state_unreadable", "The protected core-update state is invalid.")
    return value


def save_state(state_file: Path, payload: dict[str, object]) -> None:
    payload = {**payload, "schemaVersion": 1, "updatedAt": timestamp()}
    temporary = state_file.with_suffix(".tmp")
    with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as handle:
        json.dump(payload, handle, separators=(",", ":"), sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, state_file)
    os.chmod(state_file, 0o600)


def bundle_id(value: str) -> str:
    if not ID_RE.fullmatch(value or ""):
        fail("invalid_bundle_id", "The staged release reference is invalid.")
    return value


def approval_id(value: str) -> str:
    if not APPROVAL_RE.fullmatch(value or ""):
        fail("invalid_approval", "The update approval reference is invalid.")
    try:
        return str(uuid.UUID(value))
    except ValueError:
        fail("invalid_approval", "The update approval reference is invalid.")


def safe_inbox_archive(runtime: Path, identifier: str) -> Path:
    inbox = runtime / "core-update-inbox"
    if inbox.is_symlink():
        fail("unsafe_inbox", "The browser update inbox is unsafe.")
    source = inbox / f"{identifier}.tar.gz"
    try:
        metadata = source.lstat()
    except OSError:
        fail("bundle_missing", "The selected release bundle is no longer available.")
    if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
        fail("unsafe_bundle", "The selected release bundle is not a regular archive.")
    if metadata.st_size <= 0 or metadata.st_size > MAX_ARCHIVE_BYTES:
        fail("bundle_too_large", "The selected release bundle exceeds the supported size limit.")
    return source


def safe_extract(source: Path, destination: Path) -> Path:
    extracted = 0
    members = 0
    try:
        archive = tarfile.open(source, "r:gz")
    except (tarfile.TarError, OSError):
        fail("invalid_archive", "The selected release bundle is not a valid gzip archive.")
    with archive:
        for member in archive:
            members += 1
            if members > MAX_ARCHIVE_MEMBERS:
                fail("invalid_archive", "The selected release bundle contains too many files.")
            member_path = Path(member.name)
            if (not member.name or member_path.is_absolute() or ".." in member_path.parts
                    or member.issym() or member.islnk() or member.isdev()):
                fail("invalid_archive", "The selected release bundle contains an unsafe path.")
            target = (destination / member_path).resolve(strict=False)
            try:
                target.relative_to(destination)
            except ValueError:
                fail("invalid_archive", "The selected release bundle contains an unsafe path.")
            if member.isdir():
                target.mkdir(mode=0o700, parents=True, exist_ok=True)
                continue
            if not member.isfile():
                fail("invalid_archive", "The selected release bundle contains an unsupported entry.")
            extracted += member.size
            if extracted > MAX_EXTRACTED_BYTES:
                fail("bundle_too_large", "The selected release bundle expands beyond the supported size limit.")
            target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            if target.exists():
                fail("invalid_archive", "The selected release bundle contains a duplicate file.")
            source_file = archive.extractfile(member)
            if source_file is None:
                fail("invalid_archive", "The selected release bundle cannot be read safely.")
            with source_file, os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "wb") as handle:
                shutil.copyfileobj(source_file, handle, length=1024 * 1024)
    manifests = [path for path in destination.rglob("autark-os-release.json") if path.is_file()]
    if len(manifests) != 1:
        fail("invalid_archive", "The selected release bundle must contain exactly one release manifest.")
    return manifests[0].parent


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def verify_checksums(bundle: Path) -> str:
    manifest = bundle / "SHA256SUMS"
    if not manifest.is_file():
        fail("bundle_incomplete", "The selected release bundle is missing its checksum manifest.")
    listed: dict[str, str] = {}
    for line in manifest.read_text(encoding="utf-8").splitlines():
        fields = line.split(maxsplit=1)
        if len(fields) != 2:
            fail("invalid_checksums", "The selected release bundle has an invalid checksum manifest.")
        digest, raw_path = fields
        relative = raw_path[1:] if raw_path.startswith("*") else raw_path
        path = Path(relative)
        if (not re.fullmatch(r"[a-fA-F0-9]{64}", digest) or not relative
                or path.is_absolute() or ".." in path.parts or relative in listed):
            fail("invalid_checksums", "The selected release bundle has an invalid checksum manifest.")
        listed[relative] = digest.lower()
    # A detached signature is intentionally outside SHA256SUMS: including it
    # would create a circular checksum/signature dependency. It is verified
    # separately against this exact checksum manifest below.
    actual = sorted(
        str(path.relative_to(bundle))
        for path in bundle.rglob("*")
        if path.is_file() and path.name not in {"SHA256SUMS", "SHA256SUMS.sig"}
    )
    if sorted(listed) != actual:
        fail("invalid_checksums", "The selected release bundle checksum manifest does not cover exactly its files.")
    for relative, expected in listed.items():
        path = bundle / relative
        if path.is_symlink() or sha256(path) != expected:
            fail("checksum_mismatch", "The selected release bundle did not pass checksum verification.")
    return sha256(manifest)


def read_release(bundle: Path) -> dict[str, object]:
    try:
        release = json.loads((bundle / "autark-os-release.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        fail("invalid_release", "The selected release manifest is invalid.")
    if not isinstance(release, dict) or release.get("schemaVersion") not in (1, 2):
        fail("invalid_release", "The selected release manifest is invalid.")
    version = release.get("version")
    architecture = release.get("artifactArchitecture")
    if not isinstance(version, str) or not VERSION_RE.fullmatch(version) or not isinstance(architecture, str):
        fail("invalid_release", "The selected release manifest is incomplete.")
    return release


def host_architecture() -> str:
    machine = os.uname().machine.lower()
    return {"x86_64": "amd64", "aarch64": "arm64"}.get(machine, machine)


def verify_signature(bundle: Path, key: Path, verifier: Path) -> None:
    release = read_release(bundle)
    if release.get("signatureStatus") != "signed":
        fail("unsigned_bundle", "The selected release bundle is not signed for browser installation.")
    signature = bundle / "SHA256SUMS.sig"
    require_regular_root_owned(key, "signing_key_missing")
    require_regular_root_owned(verifier, "verifier_missing")
    if not signature.is_file() or signature.is_symlink():
        fail("signature_missing", "The selected release bundle is missing its signed checksum manifest.")
    result = subprocess.run(
        [str(verifier), "verify-blob", "--key", str(key), "--signature", str(signature), str(bundle / "SHA256SUMS")],
        capture_output=True,
        text=True,
        timeout=45,
        check=False,
    )
    if result.returncode != 0:
        fail("signature_invalid", "The selected release bundle signature could not be verified.")


def candidate(bundle: Path, identifier: str, checksum_identity: str) -> dict[str, object]:
    release = read_release(bundle)
    architecture = str(release["artifactArchitecture"])
    if architecture != host_architecture():
        fail("architecture_mismatch", "The selected release bundle is for a different processor architecture.")
    return {
        "architecture": architecture,
        "bundleId": identifier,
        "identity": f"sha256:{checksum_identity}",
        "version": str(release["version"]),
    }


def write_approval(approvals: Path, identifier: str, identity: str, job_id: str) -> str:
    approval = str(uuid.uuid4())
    expires = now() + APPROVAL_TTL
    payload = {
        "bundleId": identifier,
        "expiresAt": timestamp(expires),
        "identity": identity,
        "jobId": job_id,
        "used": False,
    }
    path = approvals / f"{approval}.json"
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w", encoding="utf-8") as handle:
        json.dump(payload, handle, separators=(",", ":"), sort_keys=True)
        handle.write("\n")
    return approval


def load_approval(approvals: Path, value: str, identifier: str, identity: str) -> tuple[Path, dict[str, object]]:
    approval = approval_id(value)
    path = approvals / f"{approval}.json"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        expires = dt.datetime.fromisoformat(str(payload["expiresAt"]).replace("Z", "+00:00"))
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        fail("approval_missing", "The update approval is no longer available.")
    if payload.get("used") or payload.get("bundleId") != identifier or payload.get("identity") != identity or expires <= now():
        fail("approval_invalid", "The update approval is no longer valid for this release.")
    return path, payload


def replace_approval(path: Path, payload: dict[str, object]) -> None:
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def update_cli(install: Path) -> Path:
    cli = install / "bin/autark-os"
    require_regular_root_owned(cli, "updater_missing")
    if not os.access(cli, os.X_OK):
        fail("updater_missing", "The installed Autark-OS updater is not executable.")
    return cli


def require_update_environment(install: Path, key: Path, verifier: Path) -> None:
    require_regular_root_owned(key, "signing_key_missing")
    require_regular_root_owned(verifier, "verifier_missing")
    update_cli(install)


def launch_update(helper: Path, operation: str, arguments: list[str]) -> None:
    unit = "autark-os-core-update"
    command = ["systemd-run", "--unit", unit, "--collect", "--quiet", str(helper), operation, *arguments]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        fail("systemd_runner_unavailable", "Autark-OS could not start the protected update worker.")
    if result.returncode != 0:
        fail("update_busy", "Another protected core update is already running or could not be started.")


def run_update(runtime: Path, install: Path, key: Path, verifier: Path, identifier: str, approval: str) -> None:
    _root, staged, approvals, state_file = state_paths(runtime)
    bundle = staged / identifier / "bundle"
    if not bundle.is_dir() or bundle.is_symlink():
        fail("bundle_missing", "The approved release bundle is no longer available.")
    checksum_identity = verify_checksums(bundle)
    verify_signature(bundle, key, verifier)
    release = candidate(bundle, identifier, checksum_identity)
    approval_path, approval_state = load_approval(approvals, approval, identifier, str(release["identity"]))
    approval_state["used"] = True
    replace_approval(approval_path, approval_state)
    save_state(state_file, {"candidate": release, "jobId": approval_state["jobId"], "message": "Installing the signed release and waiting for its health check.", "status": "applying"})
    log = state_file.parent / "update-worker.log"
    try:
        with log.open("a", encoding="utf-8") as handle:
            result = subprocess.run([str(update_cli(install)), "update", "apply", "--release-bundle", str(bundle), "--yes"], stdout=handle, stderr=subprocess.STDOUT, text=True, check=False)
    except (HelperError, OSError, subprocess.TimeoutExpired):
        save_state(state_file, {"candidate": release, "jobId": approval_state["jobId"], "message": "The protected update worker could not start the fixed Autark-OS updater. The recoverable release is retained for repair.", "status": "failed"})
        return
    outcome = "completed" if result.returncode == 0 else "failed"
    message = "The signed core update completed and passed its health check." if result.returncode == 0 else "The core update did not complete; Autark-OS kept or restored the recoverable release."
    save_state(state_file, {"candidate": release, "jobId": approval_state["jobId"], "message": message, "status": outcome})


def run_rollback(runtime: Path, install: Path) -> None:
    _root, _staged, _approvals, state_file = state_paths(runtime)
    prior = load_state(state_file)
    candidate_value = prior.get("candidate") if isinstance(prior.get("candidate"), dict) else None
    job_id = prior.get("jobId") if isinstance(prior.get("jobId"), str) else None
    save_state(state_file, {"candidate": candidate_value, "jobId": job_id, "message": "Restoring the last protected core-update snapshot.", "status": "rolling_back"})
    try:
        with (state_file.parent / "update-worker.log").open("a", encoding="utf-8") as handle:
            result = subprocess.run([str(update_cli(install)), "update", "rollback", "--yes"], stdout=handle, stderr=subprocess.STDOUT, text=True, check=False)
    except (HelperError, OSError, subprocess.TimeoutExpired):
        save_state(state_file, {"candidate": candidate_value, "jobId": job_id, "message": "The protected rollback worker could not start the fixed Autark-OS updater. The recoverable state is retained for repair.", "status": "failed"})
        return
    if result.returncode == 0:
        save_state(state_file, {"candidate": candidate_value, "jobId": job_id, "message": "The protected core-update snapshot was restored and passed health verification.", "status": "rolled_back"})
    else:
        save_state(state_file, {"candidate": candidate_value, "jobId": job_id, "message": "The protected rollback could not complete. The previous recoverable state is retained for repair.", "status": "failed"})


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("operation", choices=["status", "stage", "inspect", "verify", "approve", "apply", "run", "run-rollback", "health", "rollback"])
    parser.add_argument("--bundle-id", default="")
    parser.add_argument("--approval-id", default="")
    parser.add_argument("--identity", default="")
    parser.add_argument("--job-id", default="")
    args = parser.parse_args()
    try:
        require_root()
        runtime, install, key, verifier = configured_paths()
        root, staged, approvals, state_file = state_paths(runtime)
        if args.operation == "status":
            emit(load_state(state_file))
            return 0
        if args.operation == "health":
            require_update_environment(install, key, verifier)
            state = load_state(state_file)
            emit({"message": "The protected update helper is installed.", "status": state.get("status", "ready")})
            return 0
        if args.operation == "run-rollback":
            run_rollback(runtime, install)
            return 0
        if args.operation == "rollback":
            current = load_state(state_file)
            if current.get("status") not in ("completed", "failed", "rolled_back"):
                fail("rollback_unavailable", "A completed or failed protected update is required before rollback.")
            save_state(state_file, {"candidate": current.get("candidate"), "jobId": current.get("jobId"), "message": "The protected rollback worker started.", "status": "rolling_back"})
            try:
                launch_update(Path(__file__).resolve(), "run-rollback", [])
            except HelperError:
                save_state(state_file, {"candidate": current.get("candidate"), "jobId": current.get("jobId"), "message": "The protected rollback worker could not be started. The recoverable state is retained for repair.", "status": "failed"})
                raise
            emit(load_state(state_file))
            return 0
        identifier = bundle_id(args.bundle_id)
        bundle_root = staged / identifier
        if args.operation == "stage":
            source = safe_inbox_archive(runtime, identifier)
            if bundle_root.exists():
                shutil.rmtree(bundle_root)
            incomplete = root / f"{identifier}.incomplete"
            shutil.rmtree(incomplete, ignore_errors=True)
            incomplete.mkdir(mode=0o700)
            bundle = safe_extract(source, incomplete)
            bundle_root.mkdir(mode=0o700)
            shutil.move(str(bundle), str(bundle_root / "bundle"))
            shutil.rmtree(incomplete, ignore_errors=True)
            release = candidate(bundle_root / "bundle", identifier, verify_checksums(bundle_root / "bundle"))
            save_state(state_file, {"candidate": release, "message": "Release archive staged. Verifying its signed checksum manifest is required before installation.", "status": "staged"})
            emit(load_state(state_file))
            return 0
        bundle = bundle_root / "bundle"
        if not bundle.is_dir() or bundle.is_symlink():
            fail("bundle_missing", "The selected release bundle is no longer available.")
        checksum_identity = verify_checksums(bundle)
        release = candidate(bundle, identifier, checksum_identity)
        if args.operation == "inspect":
            emit({"candidate": release, "message": "Release bundle is staged.", "status": "staged"})
            return 0
        if args.operation == "verify":
            verify_signature(bundle, key, verifier)
            save_state(state_file, {"candidate": release, "message": "Release checksums and trusted signature verified.", "status": "verified"})
            emit(load_state(state_file))
            return 0
        if args.operation == "approve":
            if args.identity != release["identity"] or not args.job_id:
                fail("candidate_changed", "The release changed after review. Inspect and verify it again.")
            verify_signature(bundle, key, verifier)
            approval = write_approval(approvals, identifier, args.identity, args.job_id)
            save_state(state_file, {"approvalId": approval, "candidate": release, "jobId": args.job_id, "message": "One-time administrator approval recorded for this exact signed release.", "status": "approved"})
            emit(load_state(state_file))
            return 0
        if args.operation == "apply":
            state = load_state(state_file)
            approval = approval_id(args.approval_id)
            _path, approval_state = load_approval(approvals, approval, identifier, str(release["identity"]))
            if state.get("status") == "applying" or approval_state.get("jobId") != state.get("jobId"):
                fail("update_busy", "A protected core update is already in progress.")
            save_state(state_file, {"candidate": release, "jobId": approval_state["jobId"], "message": "The protected update worker started. Autark-OS may briefly reconnect while it verifies health.", "status": "applying"})
            try:
                launch_update(Path(__file__).resolve(), "run", ["--bundle-id", identifier, "--approval-id", approval])
            except HelperError:
                save_state(state_file, {"candidate": release, "jobId": approval_state["jobId"], "message": "The protected update worker could not be started. The recoverable release is retained for repair.", "status": "failed"})
                raise
            emit(load_state(state_file))
            return 0
        if args.operation == "run":
            run_update(runtime, install, key, verifier, identifier, args.approval_id)
            return 0
        fail("unsupported_operation", "This protected update operation is not available.")
    except HelperError as error:
        emit({"code": error.code, "message": error.message, "status": "error"})
        return 1
    except Exception:
        emit({"code": "helper_failed", "message": "The protected update helper could not complete the requested operation.", "status": "error"})
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
